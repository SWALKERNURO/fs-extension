{
  "name": "part7-bloglist",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=client",
    "start": "npm start --workspace=server",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\"",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\""
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "prettier": "^3.6.2"
  }
}
